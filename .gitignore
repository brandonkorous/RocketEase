# Infrastructure state. Terraform for this product lives in sparx.works, but a
# stray plan/state file here would carry credentials in the clear.
.terraform
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
kubeconfig
*.kubeconfig

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea
