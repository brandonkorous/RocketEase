# Local dev — matches docker-compose.yml. Production (Azure) sets these in the environment.
DATABASE_URL=postgres://mis:mis@localhost:5050/make_it_social
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5001
NEXT_PUBLIC_APP_URL=http://localhost:5001

# Email � local Mailpit (UI at http://localhost:5026). Production: provider SMTP URL from the sparx Terraform.
SMTP_URL=smtp://localhost:5025
MAIL_FROM=Make It Social <no-reply@make-it-social.local>
# Set to 1 to deliver email synchronously without the worker (dev convenience).
MAIL_INLINE=0

# Provider token encryption (32 bytes, base64). Production value comes from Key Vault.
TOKEN_MASTER_KEY=generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Providers. A provider without credentials is not offered. The mock/demo network is dev-only.
PROVIDERS_ENABLE_MOCK=1
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube = a Google Cloud OAuth client with the YouTube Data API v3 + YouTube Analytics API enabled.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Pinterest = a Pinterest developer app approved for the standard API v5 access tier.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# X = an X developer app with OAuth 2.0 (confidential client, PKCE) and Read+Write+DM permissions.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Conversion tracking sources (M7). A source without credentials is not offered in Settings -> Tracking.
# GA4 = a Google Cloud OAuth client with the Google Analytics Data API + Admin API enabled
#       (scope analytics.readonly). May reuse the YouTube client if that project has both APIs on.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
# Shopify = a custom/public app with read_orders + read_marketing_events. Reading the UTM values on an
# order needs Shopify's protected customer data approval; without it the field resolves to null.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Client-facing reports. Branded documents are always HTML; a PDF is rendered beside it only when a real
# Chromium is reachable here (and puppeteer-core is installed). Unset = no PDF, and the UI says so — never a fake one.
REPORT_CHROMIUM_PATH=

# Object storage (S3 API). Local: MinIO from docker-compose. Production: Azure Blob via S3-compatible gateway or the sparx-provisioned bucket.
STORAGE_ENDPOINT=http://localhost:5090
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mis-media
STORAGE_ACCESS_KEY=mis
STORAGE_SECRET_KEY=mis-minio-secret
STORAGE_FORCE_PATH_STYLE=1
# Public base for browser uploads/downloads (same as endpoint locally; a CDN/ingress host in prod)
STORAGE_PUBLIC_ENDPOINT=http://localhost:5090
# Optional ClamAV REST scanner; when unset, assets are marked "clean" by the no-op scanner (dev only)
CLAMAV_URL=
# Observability (OpenTelemetry). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing entirely.
# Point it at an OTLP/HTTP collector (e.g. http://otel-collector:4318); traces carry tenant ids, never tokens.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
# LOG_LEVEL=debug|info|warn|error (default: debug in dev, info in production)
LOG_LEVEL=
