# Local dev — matches docker-compose.yml. Production (Azure) sets these in the environment.
DATABASE_URL=postgres://rke:rke@localhost:5050/rocketease
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5001
# Social sign-in (optional). Google: OAuth client (Web) with redirect URI
#   ${BETTER_AUTH_URL}/api/auth/callback/google and JS origin ${BETTER_AUTH_URL}.
# The same client id powers Google One Tap; it uses FedCM, so a missing JS origin shows up only as
#   a [GSI_LOGGER] NetworkError in the console — the prompt never renders.
# NEXT_PUBLIC_AUTH_SOCIAL controls which buttons render, e.g. "google" or "google,apple".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
NEXT_PUBLIC_AUTH_SOCIAL=
NEXT_PUBLIC_APP_URL=http://localhost:5001

# Email � local Mailpit (UI at http://localhost:5026). Production: provider SMTP URL from the sparx Terraform.
SMTP_URL=smtp://localhost:5025
MAIL_FROM=RocketEase <no-reply@rocketease.local>
# Set to 1 to deliver email synchronously without the worker (dev convenience).
MAIL_INLINE=0

# Provider token encryption (32 bytes, base64). Production value comes from Key Vault.
TOKEN_MASTER_KEY=generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Providers. A provider without credentials is not offered. The mock/demo network is dev-only.
PROVIDERS_ENABLE_MOCK=1
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube = a Google Cloud OAuth client with the YouTube Data API v3 + YouTube Analytics API enabled.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Pinterest = a Pinterest developer app approved for the standard API v5 access tier.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# X = an X developer app with OAuth 2.0 (confidential client, PKCE) and Read+Write+DM permissions.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Google Business Profile = a Google Cloud OAuth client (scope business.manage) with the Business Profile
#   APIs enabled. Access is granted per project through Google's API request form; an unapproved
#   project has a quota of 0 QPM. May reuse the YouTube/GA4 client if those APIs are on the same project.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# Conversion tracking sources (M7). A source without credentials is not offered in Settings -> Tracking.
# GA4 = a Google Cloud OAuth client with the Google Analytics Data API + Admin API enabled
#       (scope analytics.readonly). May reuse the YouTube client if that project has both APIs on.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
# Shopify = a custom/public app with read_orders + read_marketing_events. Reading the UTM values on an
# order needs Shopify's protected customer data approval; without it the field resolves to null.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Client-facing reports. Branded documents are always HTML; a PDF is rendered beside it only when a real
# Chromium is reachable here (and puppeteer-core is installed). Unset = no PDF, and the UI says so — never a fake one.
REPORT_CHROMIUM_PATH=

# Object storage. STORAGE_DRIVER picks the backend and is never inferred:
#   s3    — MinIO locally (docker-compose), or any S3-compatible bucket.
#   azure — Azure Blob. Production. Azure has NO S3-compatible API, so this is a
#           separate driver, not the S3 one pointed at a different endpoint.
STORAGE_DRIVER=s3
# Local dev: the app creates the bucket/container at boot if it is missing.
# Never set in production — Terraform owns the container there.
STORAGE_AUTO_CREATE_BUCKET=1

# --- STORAGE_DRIVER=s3 ---
STORAGE_ENDPOINT=http://localhost:5090
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rke-media
STORAGE_ACCESS_KEY=rke
STORAGE_SECRET_KEY=rke-minio-secret
STORAGE_FORCE_PATH_STYLE=1
# Public base for browser uploads/downloads (same as endpoint locally).
STORAGE_PUBLIC_ENDPOINT=http://localhost:5090

# --- STORAGE_DRIVER=azure ---
# Account name and key come from Key Vault (AZURE-STORAGE-ACCOUNT / -KEY), which
# Terraform writes. The container is private; every read and write is a SAS URL.
# The browser PUTs straight to Azure, so the account's CORS rules must allow the
# app origin and the x-ms-blob-type header, or uploads fail at preflight with
# nothing reaching the app to log.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=media

# Optional ClamAV REST scanner; when unset, assets are marked "clean" by the no-op scanner (dev only)
CLAMAV_URL=
# Observability (OpenTelemetry). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing entirely.
# Point it at an OTLP/HTTP collector (e.g. http://otel-collector:4318); traces carry tenant ids, never tokens.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
# LOG_LEVEL=debug|info|warn|error (default: debug in dev, info in production)
LOG_LEVEL=

# AI drafting (M8.8). Drafts are suggestions a person edits and sends: nothing publishes,
# spends, or answers a customer without a human. With ANTHROPIC_API_KEY unset every AI
# feature is hidden and the server actions decline — never a silent half-feature.
ANTHROPIC_API_KEY=
# Model id used for drafting. Defaults to claude-sonnet-5 when unset.
AI_MODEL=claude-sonnet-5
# Where the Messages API lives. Unset = Anthropic direct. In production this is
# our own Microsoft Foundry resource, which speaks the SAME API and accepts the
# x-api-key header the SDK already sends - so it is Claude either way, just a
# different front door. When set, AI_MODEL must be the DEPLOYMENT name.
ANTHROPIC_BASE_URL=
# Renders the "Draft with AI" controls in the browser. Set to 1 only together with a key.
NEXT_PUBLIC_AI_ENABLED=

# AI is billed in credits: 1 credit = 1,000 output tokens, input tokens at a fifth.
# USD cost is optional and unpriced by default — no rates ship in this repo. Supply
# real per-1M-token rates per deployment; with this unset ai_usage.cost_usd stays null.
# AI_PRICES_JSON={"claude-sonnet-5":{"inputPerMTok":0,"outputPerMTok":0}}
AI_PRICES_JSON=

# OpenAI, as a media adapter. Optional and separate from drafting: with it unset no
# OpenAI model is offered and the "Generate image" button never renders. The model
# itself is NOT an env var — it is a pinned registry entry (packages/media catalog),
# so nothing is constructed at runtime. Results enter the content library flagged as
# AI-generated so the synthetic-media disclosure is suggested.
OPENAI_API_KEY=

# The SAME models through Azure OpenAI: the tenant's own region, the Azure
# agreement, and reachable over a private endpoint from the cluster. Preferred
# over the direct vendor when both are set. All THREE are required — an
# api-version has no default, because Azure changes behaviour across versions
# and guessing one produces a 400 that reads like a bug in our code.
#
# The DEPLOYMENT MUST BE NAMED AFTER THE MODEL (a deployment called
# `gpt-image-1`), because the deployment name is the URL path segment and the
# registry pins model ids rather than constructing them.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
# What THIS Azure resource calls the image model. sparx.works names deployments
# after the seam that uses them (`jotdojo-vision`), not after the model. Unset,
# the deployment is assumed to carry the model's own name. This addresses a
# model; it does not choose one — the catalog still pins that.
AZURE_OPENAI_IMAGE_DEPLOYMENT=

# Billing (Stripe). Flat price per workspace per month, unlimited seats, client reviewers free;
# AI above the included allowance is metered in credits. Every amount is a Stripe object — no
# price is ever written in this repo. With STRIPE_SECRET_KEY unset, billing is off: nothing is
# charged, nothing is gated, and Settings -> Billing says so.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring prices on the "Workspace" product, billed per unit (quantity = active workspaces).
STRIPE_PRICE_WORKSPACE_MONTHLY=
STRIPE_PRICE_WORKSPACE_YEARLY=
# Billing meter event name (e.g. ai_credits) and the metered price that bills it.
STRIPE_METER_AI_CREDITS=
STRIPE_PRICE_AI_CREDIT_OVERAGE=
# AI credits included with each billed workspace per period (default 200).
BILLING_INCLUDED_AI_CREDITS=200
# Free trial length applied to a new subscription; 0 disables the trial (default 14).
BILLING_TRIAL_DAYS=14

# --- Staff & betas (M12.1) ---------------------------------------------------
# RocketEase's own operators. Bootstrap only: `staff_user` rows are the source
# of truth and win over this list, so an address here can be demoted without a
# redeploy. The env path requires a VERIFIED email. Comma-separated.
STAFF_EMAILS=

# Beta enrolment bootstrap, as `feature:organizationId` pairs. `feature_grant`
# rows are the source of truth; an explicit revoke beats anything listed here.
#   BETA_FEATURES=media.generation:org_abc,media.generation:org_def
BETA_FEATURES=

# --- Media pipeline (M12.1) --------------------------------------------------
# ffmpeg/ffprobe. Unset = they must be on PATH. If they are genuinely absent the
# pipeline records duration and dimensions as UNKNOWN with a reason — never 0,
# which would silently pass every network limit check.
FFMPEG_PATH=
FFPROBE_PATH=
# Renders need real disk; in-cluster this points at the media worker's volume.
MEDIA_SCRATCH_DIR=
MEDIA_MAX_CONCURRENCY=2
MEDIA_JOB_TIMEOUT_SECONDS=900

# Deterministic local loop: full submit -> poll -> fetch -> asset, no vendor, no spend.
MEDIA_ENABLE_MOCK=1

# Per-model rates, shaped like AI_PRICES_JSON. PLACEHOLDER: this repo ships no
# invented per-second rate. Unset = cost stays null and the UI says so.
#   AI_MEDIA_RATES_JSON={"mock-video":0}
AI_MEDIA_RATES_JSON=

# Blast-radius limits while pricing is deferred. NOT pricing — a ceiling so a
# runaway loop cannot spend without bound.
MEDIA_CEILING_USD_PER_JOB=
MEDIA_CEILING_USD_PER_ORG_MONTH=

# Which half of the work this worker process does: general (default) or media.
WORKER_ROLE=
