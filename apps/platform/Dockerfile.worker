# syntax=docker/dockerfile:1.7
# Background worker for apps/platform. Build from the monorepo root:
#   docker build -f apps/platform/Dockerfile.worker -t rocketease/worker .
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/platform/package.json apps/platform/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter @rocketease/platform...

FROM deps AS runner
COPY packages/ui packages/ui
COPY apps/platform apps/platform
ENV NODE_ENV=production RKE_PROCESS=worker
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /repo
USER app
WORKDIR /repo/apps/platform
# tsx runs the TypeScript entrypoint directly; no Next build needed for the worker.
CMD ["pnpm", "exec", "tsx", "worker/index.ts"]
