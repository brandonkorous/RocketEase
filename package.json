{
  "name": "rocketease",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "docker compose up -d && pnpm -r --parallel --stream run \"/^(dev|worker)$/\"",
    "dev:web": "pnpm --filter @rocketease/web dev",
    "dev:platform": "docker compose up -d && pnpm --filter @rocketease/platform --parallel run \"/^(dev|worker)$/\"",
    "dev:kill": "node scripts/dev-kill.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @rocketease/platform db:migrate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "worker": "pnpm --filter @rocketease/platform worker",
    "test": "pnpm -r test"
  }
}
